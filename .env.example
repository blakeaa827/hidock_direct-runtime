# HiDock Direct — configuration template.
# Copy to .env (cp .env.example .env) and fill in your AssemblyAI key.
# .env is gitignored; this template is committed. Never put a real key here.

# --- Required ---------------------------------------------------------------
# Your AssemblyAI API key (https://www.assemblyai.com/ → dashboard).
# Consumed by the vendored diarize_audio for transcription + diarization.
ASSEMBLYAI_API_KEY=

# --- Archive ----------------------------------------------------------------
# Where offloaded audio + transcripts (.mp3/.md/.aai.json) are saved.
HIDOCK_ARCHIVE_DIR=~/hidock-archive

# --- Google Drive upload (advanced; off by default) -------------------------
# Leave false — transcripts are saved to your local archive.
DRIVE_ENABLED=false

# --- Behavior (optional; defaults shown) ------------------------------------
# Transcribe each recording immediately after offload.
TRANSCRIBE_ON_OFFLOAD=true
# Delete the file from the HiDock device after a successful offload.
DELETE_FROM_DEVICE_AFTER_OFFLOAD=false
# Seconds between device polls.
POLL_INTERVAL_SECONDS=10
# Log verbosity: debug | info | warning | error
LOG_LEVEL=info

# --- Transcription tuning (optional; uncomment to override) -----------------
# AssemblyAI model. 'best' (default) lets AssemblyAI pick its current
# best model; 'universal-2' pins the cheaper, faster one.
#SPEECH_MODEL=best
# Force a language instead of auto-detect (e.g. en). Blank = auto.
#LANGUAGE_CODE=
# Comma-separated terms to boost recognition (names, jargon).
#WORD_BOOST=

# Your name, as it should appear in LIVE transcripts. The near channel of a
# live call is you by construction, so this is written into the permanent
# archive as the speaker label -- e.g. `**Blake Anderson** (00:04): ...`.
#
# Unset, live transcripts say `**Me**`. That is a safe neutral label on screen,
# but in the archive every downstream consumer reads a bold label as a person's
# name, so a shelf of transcripts attributed to "Me" is worse than useless.
# Set it before running a live session you intend to keep.
HIDOCK_OPERATOR_NAME=

# Ceiling on FAR-channel speakers for live diarization (default 6). It is a
# CEILING, not a hint: set it too high and AssemblyAI will split one voice into
# two on a quiet call. The count you want is participants MINUS one, because
# you are always on the near channel and are never diarized.
HIDOCK_LIVE_MAX_SPEAKERS=6
