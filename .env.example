# HiDock Direct — configuration template.
# Copy to .env (cp .env.example .env) and fill in your AssemblyAI key.
# .env is gitignored; this template is committed. Never put a real key here.

# --- Required ---------------------------------------------------------------
# Your AssemblyAI API key (https://www.assemblyai.com/ → dashboard).
# Consumed by the vendored diarize_audio for transcription + diarization.
ASSEMBLYAI_API_KEY=

# --- Archive ----------------------------------------------------------------
# Where offloaded audio + transcripts (.mp3/.md/.aai.json) are saved.
HIDOCK_ARCHIVE_DIR=~/hidock-archive

# --- Google Drive upload (advanced; off by default) -------------------------
# Leave false — transcripts are saved to your local archive.
DRIVE_ENABLED=false

# --- Behavior (optional; defaults shown) ------------------------------------
# Transcribe each recording immediately after offload.
TRANSCRIBE_ON_OFFLOAD=true
# Delete the file from the HiDock device after a successful offload.
DELETE_FROM_DEVICE_AFTER_OFFLOAD=false
# Seconds between device polls.
POLL_INTERVAL_SECONDS=10
# Log verbosity: debug | info | warning | error
LOG_LEVEL=info

# --- Transcription tuning (optional; uncomment to override) -----------------
# AssemblyAI model. 'best' (default) lets AssemblyAI pick its current
# best model; 'universal-2' pins the cheaper, faster one.
#SPEECH_MODEL=best
# Force a language instead of auto-detect (e.g. en). Blank = auto.
#LANGUAGE_CODE=
# Comma-separated terms to boost recognition (names, jargon).
#WORD_BOOST=

# Your name, as it should appear in LIVE transcripts. The near channel of a
# live call is you by construction, so this is written into the permanent
# archive as the speaker label -- e.g. `**Blake Anderson** (00:04): ...`.
#
# Unset, live transcripts say `**Me**`. That is a safe neutral label on screen,
# but in the archive every downstream consumer reads a bold label as a person's
# name, so a shelf of transcripts attributed to "Me" is worse than useless.
# Set it before running a live session you intend to keep.
HIDOCK_OPERATOR_NAME=

# DIAGNOSTIC ONLY, and off unless you set it. A live session records a WAV while
# the call runs, transcodes it to MP3 at the end, and deletes the WAV. Point this
# at a directory and the WAV is moved there instead -- the exact bytes captured,
# before the encoder touched them, which is the only way to tell a capture
# artifact (clicking, dropouts) from an encoding one.
#
# Two warnings, both real:
#   * It is RAW CALL AUDIO, unencrypted, ~230 MB per hour, and nothing deletes
#     it. Unset this when you have collected what you need.
#   * Do NOT point it inside HIDOCK_ARCHIVE_DIR. The transcription pipeline
#     scans that directory for `.wav` files, so a WAV left there would be
#     transcribed a SECOND time, and billed, for a call already transcribed live.
HIDOCK_LIVE_KEEP_WAV_DIR=

# The speaker count the live prompt is PREPOPULATED with (default 8). Pressing
# `l` asks how many speakers to expect on this call and opens with this number,
# so Enter alone starts the session; type a different one to override it for
# that call only. It is not a fixed ceiling any more -- the right value is
# per-call and only you know it.
#
# Accepted range is 1-10, AssemblyAI's own hard cap. It is a strict limit, not a
# hint: once it is reached, additional speakers are MERGED into the closest
# existing label rather than given a new one. Set it too high and the model
# over-splits, putting one voice on two labels.
#
# Count the PEOPLE ON THE CALL, INCLUDING YOURSELF -- the same question the `l`
# prompt asks, so the two cannot disagree. An earlier version of this file said
# "participants minus one", which is the same number one lower and made the
# prompt and the template define one variable two ways.
#
# Including yourself is not an approximation. The ceiling only ever bounds the
# FAR channel, which carries everyone EXCEPT you (your own voice is the near
# channel and is never diarized), so counting yourself in leaves exactly the
# "little headroom above the number you expect" the vendor asks for -- without
# making you do arithmetic mid-call.
HIDOCK_LIVE_MAX_SPEAKERS=8
